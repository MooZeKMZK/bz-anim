pkgbase = bz-anim
	pkgdesc = 2D Belousov-Zhabotinsky reaction-diffusion simulator (core, CLI, Textual TUI, PySide6 GUI)
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/MooZeKMZK/bz-anim
	arch = any
	license = MIT
	makedepends = python-build
	makedepends = python-installer
	makedepends = python-setuptools
	makedepends = python-wheel
	source = bz-anim-0.1.0.tar.gz::https://github.com/MooZeKMZK/bz-anim/archive/refs/tags/v0.1.0.tar.gz
	sha256sums = SKIP

pkgname = python-bz-anim-core
	pkgdesc = Core 2D Belousov-Zhabotinsky simulation engine, TOML config, and Neo-Brutalist theme system
	depends = python
	depends = python-numpy
	depends = python-pillow
	backup = etc/bz-anim/config.toml
	backup = etc/bz-anim/theme.toml

pkgname = bz-anim-cli
	pkgdesc = Command-line interface (bz-cli) for the Belousov-Zhabotinsky reaction-diffusion simulator
	depends = python-bz-anim-core

pkgname = bz-anim-tui
	pkgdesc = Neo-Brutalist Textual terminal UI (bz-tui) for the Belousov-Zhabotinsky simulator
	depends = python-bz-anim-core
	depends = bz-anim-cli
	depends = python-textual

pkgname = bz-anim-gui
	pkgdesc = Neo-Brutalist PySide6 desktop GUI (bz-gui) for the Belousov-Zhabotinsky simulator
	depends = python-bz-anim-core
	depends = bz-anim-cli
	depends = pyside6

pkgname = bz-anim
	pkgdesc = Unified umbrella dispatcher (bz-anim) for the Belousov-Zhabotinsky reaction-diffusion simulator
	depends = python-bz-anim-core
	depends = bz-anim-cli
	optdepends = bz-anim-tui: Neo-Brutalist Textual terminal UI (--tui)
	optdepends = bz-anim-gui: Neo-Brutalist PySide6 desktop GUI (--gui)
